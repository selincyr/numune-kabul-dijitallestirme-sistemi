@page "{id:int}"
@model NumuneKabul.Web.Pages.Templates.DetailsModel

@{
    ViewData["Title"] = "Şablon Detayı";
}

<div class="container mt-4">
    @if (Model.Template is not null)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2>@Model.Template.Name</h2>
                <div class="text-muted">
                    Kurum: @(Model.Template.Institution?.Name ?? "-")
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-page="./AddField"
                   asp-route-templateId="@Model.Template.Id"
                   class="btn btn-primary">
                    Alan Ekle
                </a>

                <a asp-page="./Index" class="btn btn-secondary">
                    Şablon Listesine Dön
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] is not null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] is not null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header">
                Şablon Bilgileri
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Şablon ID</dt>
                    <dd class="col-sm-9">@Model.Template.Id</dd>

                    <dt class="col-sm-3">Şablon Adı</dt>
                    <dd class="col-sm-9">@Model.Template.Name</dd>

                    <dt class="col-sm-3">Açıklama</dt>
                    <dd class="col-sm-9">@Model.Template.Description</dd>

                    <dt class="col-sm-3">Alan Sayısı</dt>
                    <dd class="col-sm-9">@Model.Template.TemplateFields.Count</dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header">
                Şablon Alanları
            </div>

            <div class="card-body table-responsive">
                @if (!Model.Template.TemplateFields.Any())
                {
                    <div class="alert alert-info mb-0">
                        Bu şablona henüz alan eklenmemiş.
                    </div>
                }
                else
                {
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Sıra</th>
                                <th>Alan Adı</th>
                                <th>Anahtar Kelime</th>
                                <th>Regex</th>
                                <th>Veri Tipi</th>
                                <th>Zorunlu</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var field in Model.Template.TemplateFields)
                            {
                                <tr>
                                    <td>@field.OrderNo</td>
                                    <td>@field.FieldName</td>
                                    <td>@field.Keyword</td>
                                    <td>
                                        <code>@field.Regex</code>
                                    </td>
                                    <td>@field.DataType</td>
                                    <td>
                                        @if (field.Required)
                                        {
                                            <span class="badge bg-danger">Evet</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Hayır</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-page="./EditField"
                                           asp-route-id="@field.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Düzenle
                                        </a>

                                        <form method="post"
                                              asp-page-handler="DeleteField"
                                              asp-route-id="@Model.Template.Id"
                                              asp-route-fieldId="@field.Id"
                                              class="d-inline"
                                              onsubmit="return confirm('Bu alanı silmek istediğinize emin misiniz?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Sil
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
</div>