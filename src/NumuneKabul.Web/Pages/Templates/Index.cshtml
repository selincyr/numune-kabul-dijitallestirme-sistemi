@page
@model NumuneKabul.Web.Pages.Templates.IndexModel

@{
    ViewData["Title"] = "Form Şablonları";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Form Şablonları</h2>

        <a asp-page="./Create" class="btn btn-primary">
            Yeni Şablon
        </a>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Templates.Any())
    {
        <div class="alert alert-info">
            Henüz form şablonu bulunmuyor.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Kurum</th>
                            <th>Şablon Adı</th>
                            <th>Açıklama</th>
                            <th>Alan Sayısı</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var template in Model.Templates)
                        {
                            <tr>
                                <td>@template.Id</td>
                                <td>@(template.Institution?.Name ?? "-")</td>
                                <td>@template.Name</td>
                                <td>@template.Description</td>
                                <td>@template.TemplateFields.Count</td>
                                <td class="text-end">
                                    <a asp-page="./Details"
                                       asp-route-id="@template.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Detay
                                    </a>

                                    <form method="post"
                                          asp-page-handler="Delete"
                                          asp-route-id="@template.Id"
                                          class="d-inline"
                                          onsubmit="return confirm('Bu şablonu silmek istediğinize emin misiniz? Bu işlem şablon alanlarını da siler.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>