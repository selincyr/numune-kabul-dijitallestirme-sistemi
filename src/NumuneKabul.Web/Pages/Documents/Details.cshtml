@page "{id:int}"
@model NumuneKabul.Web.Pages.Documents.DetailsModel

@{
    ViewData["Title"] = "Belge Detayı";
}

<div class="container mt-4">

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @if (Model.Document is null)
    {
        <div class="alert alert-warning">
            Belge bulunamadı.
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-4">

                <div class="card mb-3">
                    <div class="card-header">
                        Belge Bilgileri
                    </div>

                    <div class="card-body">
                        <p>
                            <strong>Dosya Adı:</strong><br />
                            @Model.Document.FileName
                        </p>

                        <p>
                            <strong>Kurum:</strong><br />
                            @Model.Document.Institution?.Name
                        </p>

                        <p>
                            <strong>Yükleme Tarihi:</strong><br />
                            @Model.Document.UploadDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </p>

                        <p>
                            <strong>Durum:</strong><br />
                            @Model.Document.Status
                        </p>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        İşlemler
                    </div>

                    <div class="card-body">

                        <form method="post" asp-page-handler="Render" asp-route-id="@Model.Document.Id" class="mb-2">
                            <button type="submit" class="btn btn-primary w-100">
                                Sayfaları PNG Olarak Hazırla
                            </button>
                        </form>

                        <form method="post" asp-page-handler="Ocr" asp-route-id="@Model.Document.Id" class="mb-2">
                            <button type="submit" class="btn btn-success w-100">
                                OCR Başlat
                            </button>
                        </form>

                        <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Document.Id"
                              onsubmit="return confirm('Bu belgeyi silmek istediğinize emin misiniz?');">
                            <button type="submit" class="btn btn-danger w-100">
                                Belgeyi Sil
                            </button>
                        </form>

                    </div>
                </div>

                <a asp-page="./Index" class="btn btn-secondary w-100 mt-3">
                    Belge Listesine Dön
                </a>

            </div>

            <div class="col-md-8">

                <div class="card">
                    <div class="card-header">
                        PDF Önizleme
                    </div>

                    <div class="card-body">
                        <iframe src="?handler=Preview&id=@Model.Document.Id"
                                style="width: 100%; height: 700px; border: 1px solid #ddd;">
                        </iframe>
                    </div>
                </div>

                @if (Model.ExtractedFields.Any())
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            Çıkarılan Alanlar / Manuel Doğrulama
                        </div>

                        <div class="card-body">
                            <form method="post" asp-page-handler="SaveFields" asp-route-id="@Model.Document.Id">

                                <table class="table table-bordered table-striped">
                                    <thead>
                                        <tr>
                                            <th>Alan Adı</th>
                                            <th>OCR Değeri</th>
                                            <th>Düzeltilmiş Değer</th>
                                            <th>Güven</th>
                                            <th>Durum</th>
                                            <th>Sayfa</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var field in Model.ExtractedFields)
                                        {
                                            var rawValue = field.RawValue?.Trim() ?? string.Empty;
                                            var correctedValue = field.CorrectedValue?.Trim() ?? string.Empty;

                                            var isManuallyCorrected =
                                                !string.IsNullOrWhiteSpace(correctedValue) &&
                                                !string.Equals(rawValue, correctedValue, StringComparison.OrdinalIgnoreCase);

                                            var badgeClass = "bg-danger";
                                            var statusText = "Düşük Güven";

                                            if (isManuallyCorrected)
                                            {
                                                badgeClass = "bg-info text-dark";
                                                statusText = "Manuel Düzeltildi";
                                            }
                                            else if (field.Confidence >= 85)
                                            {
                                                badgeClass = "bg-success";
                                                statusText = "Yüksek Güven";
                                            }
                                            else if (field.Confidence >= 60)
                                            {
                                                badgeClass = "bg-warning text-dark";
                                                statusText = "Kontrol Edilmeli";
                                            }

                                            <tr>
                                                <td>@field.FieldName</td>
                                                <td>@field.RawValue</td>
                                                <td>
                                                    <input type="text"
                                                           name="correctedValues[@field.Id]"
                                                           value="@field.CorrectedValue"
                                                           class="form-control" />
                                                </td>
                                                <td>@field.Confidence.ToString("0")%</td>
                                                <td>
                                                    <span class="badge @badgeClass">
                                                        @statusText
                                                    </span>
                                                </td>
                                                <td>@field.PageNo</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                <button type="submit" class="btn btn-warning w-100">
                                    Düzeltmeleri Kaydet
                                </button>

                            </form>
                        </div>
                    </div>
                }

                @if (Model.OcrResults.Any())
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            OCR Sonuçları
                        </div>

                        <div class="card-body">
                            @foreach (var result in Model.OcrResults)
                            {
                                <div class="mb-3">
                                    <h6>Sayfa @result.PageNo</h6>

                                    @if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
                                    {
                                        <div class="alert alert-danger">
                                            @result.ErrorMessage
                                        </div>
                                    }
                                    else if (string.IsNullOrWhiteSpace(result.RawText))
                                    {
                                        <div class="alert alert-warning">
                                            Bu sayfadan OCR metni çıkarılamadı.
                                        </div>
                                    }
                                    else
                                    {
                                        <pre style="white-space: pre-wrap; background-color: #f8f9fa; padding: 12px; border-radius: 6px;">@result.RawText</pre>
                                    }
                                </div>

                                <hr />
                            }
                        </div>
                    </div>
                }

            </div>
        </div>
    }

</div>