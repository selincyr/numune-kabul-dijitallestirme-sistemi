@page "{id:int}"
@model NumuneKabul.Web.Pages.Documents.DetailsModel
@using NumuneKabul.Domain.Enums

@{
    ViewData["Title"] = "Belge Detayı";
}

<div class="container mt-4">

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @if (Model.Document is null)
    {
        <div class="alert alert-warning">
            Belge bulunamadı.
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-4">

                <div class="card mb-3">
                    <div class="card-header">
                        Belge Bilgileri
                    </div>

                    <div class="card-body">
                        <p>
                            <strong>Dosya Adı:</strong><br />
                            @Model.Document.FileName
                        </p>

                        <p>
                            <strong>Kurum:</strong><br />
                            @Model.Document.Institution?.Name
                        </p>

                        <p>
                            <strong>Yükleme Tarihi:</strong><br />
                            @Model.Document.UploadDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </p>

                        <p>
                            <strong>Durum:</strong><br />
                            @Model.Document.Status
                        </p>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        İşlemler
                    </div>

                    <div class="card-body">

                        <div class="alert alert-info small">
                            PDF sayfaları yükleme sırasında otomatik olarak PNG formatına dönüştürülür.
                            Gerekirse aşağıdaki buton ile yeniden oluşturabilirsiniz.
                        </div>

                        <form method="post" asp-page-handler="Render" asp-route-id="@Model.Document.Id" class="mb-2">
                            <button type="submit" class="btn btn-primary w-100">
                                PNG Sayfalarını Yeniden Oluştur
                            </button>
                        </form>

                        <form method="post" asp-page-handler="Ocr" asp-route-id="@Model.Document.Id" class="mb-2">
                            <button type="submit" class="btn btn-success w-100">
                                OCR Başlat
                            </button>
                        </form>

                        <form method="post" asp-page-handler="CreateXml" asp-route-id="@Model.Document.Id" class="mb-2">
                            <button type="submit" class="btn btn-dark w-100">
                                XML Oluştur
                            </button>
                        </form>

                        <form method="post" asp-page-handler="SendIntegration" asp-route-id="@Model.Document.Id" class="mb-2">
                            <button type="submit" class="btn btn-success w-100">
                                Mock Servise Gönder
                            </button>
                        </form>

                        <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Document.Id"
                              onsubmit="return confirm('Bu belgeyi silmek istediğinize emin misiniz?');">
                            <button type="submit" class="btn btn-danger w-100">
                                Belgeyi Sil
                            </button>
                        </form>

                    </div>
                </div>

                <a asp-page="./Index" class="btn btn-secondary w-100 mt-3">
                    Belge Listesine Dön
                </a>

            </div>

            <div class="col-md-8">

                <div class="card">
                    <div class="card-header">
                        PDF Önizleme
                    </div>

                    <div class="card-body">
                        <iframe src="?handler=Preview&id=@Model.Document.Id"
                                style="width: 100%; height: 700px; border: 1px solid #ddd;">
                        </iframe>
                    </div>
                </div>

                @if (Model.ExtractedFields.Any(x => x.X.HasValue && x.Y.HasValue && x.Width.HasValue && x.Height.HasValue))
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            PDF Üzerinde İşaretlenen Alanlar
                        </div>

                        <div class="card-body">
                            <div class="alert alert-info small">
                                OCR sonrası koordinatı bulunan alanlar PDF sayfa görüntüsü üzerinde renkli kutularla gösterilir.
                            </div>

                            <div class="mb-3 small">
                                <span class="badge bg-success">Doğrulandı</span>
                                <span class="badge bg-warning text-dark">Kontrol Gerekli</span>
                                <span class="badge bg-danger">Bulunamadı</span>
                            </div>

                            @foreach (var pageGroup in Model.ExtractedFields
                                .Where(x => x.X.HasValue && x.Y.HasValue && x.Width.HasValue && x.Height.HasValue)
                                .GroupBy(x => x.PageNo)
                                .OrderBy(x => x.Key))
                            {
                                <h6 class="mt-3">Sayfa @pageGroup.Key</h6>

                                <div style="overflow: auto; border: 1px solid #ddd; padding: 8px; margin-bottom: 16px;">
                                    <div style="position: relative; display: inline-block;">
                                        <img src="?handler=RenderedPage&id=@Model.Document.Id&pageNo=@pageGroup.Key"
                                             style="display: block; max-width: none;" />

                                        @foreach (var field in pageGroup)
                                        {
                                            var borderColor = field.Status switch
                                            {
                                                FieldStatus.Verified => "#198754",
                                                FieldStatus.NeedsReview => "#ffc107",
                                                FieldStatus.NotFound => "#dc3545",
                                                _ => "#6c757d"
                                            };

                                            var backgroundColor = field.Status switch
                                            {
                                                FieldStatus.Verified => "rgba(25, 135, 84, 0.15)",
                                                FieldStatus.NeedsReview => "rgba(255, 193, 7, 0.25)",
                                                FieldStatus.NotFound => "rgba(220, 53, 69, 0.15)",
                                                _ => "rgba(108, 117, 125, 0.15)"
                                            };

                                            var fieldValue = !string.IsNullOrWhiteSpace(field.CorrectedValue)
                                                ? field.CorrectedValue
                                                : field.RawValue;

                                            <div title="@($"{field.FieldName}: {fieldValue}")"
                                                 style="
                                                    position: absolute;
                                                    left: @(field.X ?? 0)px;
                                                    top: @(field.Y ?? 0)px;
                                                    width: @(field.Width ?? 0)px;
                                                    height: @(field.Height ?? 0)px;
                                                    border: 3px solid @borderColor;
                                                    background-color: @backgroundColor;
                                                    box-sizing: border-box;">
                                            </div>

                                            <div style="
                                                    position: absolute;
                                                    left: @(field.X ?? 0)px;
                                                    top: @(Math.Max(0, (field.Y ?? 0) - 24))px;
                                                    background-color: @borderColor;
                                                    color: white;
                                                    font-size: 12px;
                                                    padding: 2px 6px;
                                                    border-radius: 4px;
                                                    white-space: nowrap;">
                                                @field.FieldName
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (Model.ExtractedFields.Any())
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            Çıkarılan Alanlar / Manuel Doğrulama
                        </div>

                        <div class="card-body">
                            <form method="post" asp-page-handler="SaveFields" asp-route-id="@Model.Document.Id">

                                <table class="table table-bordered table-striped">
                                    <thead>
                                        <tr>
                                            <th>Alan Adı</th>
                                            <th>OCR Değeri</th>
                                            <th>Düzeltilmiş Değer</th>
                                            <th>Güven</th>
                                            <th>Durum</th>
                                            <th>Sayfa</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var field in Model.ExtractedFields)
                                        {
                                            var rawValue = field.RawValue?.Trim() ?? string.Empty;
                                            var correctedValue = field.CorrectedValue?.Trim() ?? string.Empty;

                                            var isManuallyCorrected =
                                                !string.IsNullOrWhiteSpace(correctedValue) &&
                                                !string.Equals(rawValue, correctedValue, StringComparison.OrdinalIgnoreCase);

                                            var badgeClass = "bg-secondary";
                                            var statusText = "Bilinmiyor";

                                            if (isManuallyCorrected)
                                            {
                                                badgeClass = "bg-info text-dark";
                                                statusText = "Manuel Düzeltildi";
                                            }
                                            else if (field.Status == FieldStatus.Verified)
                                            {
                                                badgeClass = "bg-success";
                                                statusText = "Bulundu / Doğrulandı";
                                            }
                                            else if (field.Status == FieldStatus.NeedsReview)
                                            {
                                                badgeClass = "bg-warning text-dark";
                                                statusText = "Kontrol Edilmeli";
                                            }
                                            else if (field.Status == FieldStatus.NotFound)
                                            {
                                                badgeClass = "bg-danger";
                                                statusText = "Bulunamadı";
                                            }

                                            <tr>
                                                <td>@field.FieldName</td>
                                                <td>@field.RawValue</td>
                                                <td>
                                                    <input type="text"
                                                           name="correctedValues[@field.Id]"
                                                           value="@field.CorrectedValue"
                                                           class="form-control" />
                                                </td>
                                                <td>@field.Confidence.ToString("0")%</td>
                                                <td>
                                                    <span class="badge @badgeClass">
                                                        @statusText
                                                    </span>
                                                </td>
                                                <td>@field.PageNo</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                <button type="submit" class="btn btn-warning w-100">
                                    Düzeltmeleri Kaydet
                                </button>

                            </form>
                        </div>
                    </div>
                }

                @if (Model.XmlArchives.Any())
                {
                    var latestXml = Model.XmlArchives.First();

                    <div class="card mt-3">
                        <div class="card-header">
                            XML Çıktısı
                        </div>

                        <div class="card-body">
                            <p>
                                <strong>Oluşturulma Tarihi:</strong>
                                @latestXml.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </p>

                            <pre style="white-space: pre-wrap; background-color: #f8f9fa; padding: 12px; border-radius: 6px;">@latestXml.XmlContent</pre>
                        </div>
                    </div>
                }

                <div class="card mt-3">
                    <div class="card-header">
                        Entegrasyon Kayıtları
                    </div>

                    <div class="card-body">
                        @if (!Model.IntegrationJobs.Any())
                        {
                            <div class="alert alert-info">
                                Henüz entegrasyon kaydı bulunmamaktadır.
                            </div>
                        }
                        else
                        {
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>Tarih</th>
                                        <th>Durum</th>
                                        <th>Deneme Sayısı</th>
                                        <th>Son Deneme Tarihi</th>
                                        <th>Hata Mesajı</th>
                                        <th>İşlem</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var job in Model.IntegrationJobs)
                                    {
                                        var badgeClass = job.Status switch
                                        {
                                            IntegrationStatus.Pending => "bg-secondary",
                                            IntegrationStatus.Processing => "bg-info text-dark",
                                            IntegrationStatus.Success => "bg-success",
                                            IntegrationStatus.Failed => "bg-danger",
                                            _ => "bg-light text-dark"
                                        };

                                        <tr>
                                            <td>@job.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>

                                            <td>
                                                <span class="badge @badgeClass">
                                                    @job.Status
                                                </span>
                                            </td>

                                            <td>@job.RetryCount</td>

                                            <td>
                                                @(job.LastAttemptDate.HasValue
                                                    ? job.LastAttemptDate.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                                    : "-")
                                            </td>

                                            <td>@(job.LastErrorMessage ?? "-")</td>

                                            <td>
                                                @if (job.Status == IntegrationStatus.Failed)
                                                {
                                                    <form method="post"
                                                          asp-page-handler="RetryIntegration"
                                                          asp-route-id="@Model.Document.Id"
                                                          asp-route-jobId="@job.Id"
                                                          class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-warning">
                                                            Tekrar Gönder
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>

                @if (Model.OcrResults.Any())
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            OCR Sonuçları
                        </div>

                        <div class="card-body">
                            @foreach (var result in Model.OcrResults)
                            {
                                <div class="mb-3">
                                    <h6>Sayfa @result.PageNo</h6>

                                    @if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
                                    {
                                        <div class="alert alert-danger">
                                            @result.ErrorMessage
                                        </div>
                                    }
                                    else if (string.IsNullOrWhiteSpace(result.RawText))
                                    {
                                        <div class="alert alert-warning">
                                            Bu sayfadan OCR metni çıkarılamadı.
                                        </div>
                                    }
                                    else
                                    {
                                        <pre style="white-space: pre-wrap; background-color: #f8f9fa; padding: 12px; border-radius: 6px;">@result.RawText</pre>
                                    }
                                </div>

                                <hr />
                            }
                        </div>
                    </div>
                }

            </div>
        </div>
    }

</div>